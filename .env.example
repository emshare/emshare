# 动态代理配置示例：复制为 .env 后按需修改（.env 已在 .gitignore，不入库）。
# 短效 IP：TTL 与 provider 的 time 参数同口径（默认 30 秒），过期前留安全余量自动换 IP。

# 代理总开关：1=开启，0=关闭（关闭后全程直连，等价 EM_PROXY_MODE=never）
EM_PROXY_ENABLED=1

# 代理 API 地址（携趣动态 IP）：返回 ip:port 文本，按行解析。替换 YOUR_UID/YOUR_VKEY。
# 注意：URL 含 & 时不要用 source .env 加载（bash 会截断），本项目用 em.core.env.load_dotenv 安全加载。
EM_PROXY_API=http://api.xiequ.cn/VAD/GetIp.aspx?act=get&uid=YOUR_UID&vkey=YOUR_VKEY&num=3&time=30&plat=1&re=1&type=0&so=1&ow=1&spl=1&addr=&db=1

# 每次回源拉取的代理 IP 数量（备用池大小，1=只取当前用，>1 可减少回源频率）
# 注意：携趣 API URL 中的 num 参数必须与此一致，实际返回数量以 URL 参数为准
EM_PROXY_NUM=3

# 代理 IP 有效期（秒）：与 API 的 time 参数同口径，过期后自动换 IP
EM_PROXY_TTL_SEC=30

# 安全余量（秒）：TTL 到期前提前这么多秒视为过期，避免用到临过期 IP
EM_PROXY_SAFETY_MARGIN_SEC=3

# 拉取代理 API 的超时（秒）：超时则返回空列表，退化直连
EM_PROXY_TIMEOUT_SEC=8

# 代理路由模式：auto=默认直连，某 host 被封后自动切代理，代理稳定后周期探测回退直连；
# always=全程代理；never=全程直连。auto 下各 host(push2/push2his/pushguest)独立决策。
EM_PROXY_MODE=auto

# auto 模式：直连连续失败达此阈值后切代理（403/429 立即切，不等待累计）
EM_PROXY_DIRECT_FAILS=3

# auto 模式：代理下连续成功达此阈值后，尝试探测直连是否恢复
EM_PROXY_PROXY_SUCCESSES=5

# auto 模式：切代理后的冷却期（秒）：期间不做探测，避免刚切代理就频繁试探直连
EM_PROXY_COOLDOWN_SEC=300

# 单次 HTTP 请求超时（秒）：(连接, 读取) 分别计时，超时归类为 NetworkError 触发换 IP 重试。
# 坏代理多卡在连接阶段，connect 取小值可快速判死（requests 元组超时，二者不叠加）。
# 读取超时同时作为动态超时的上限（不放宽超过此值）
EM_REQUEST_CONNECT_TIMEOUT_SEC=3
EM_REQUEST_TIMEOUT_SEC=2

# 动态读超时（P95 滑动窗口）：1=开启。按直连/代理分桶统计最近 20 次成功请求耗时，
# 读超时 = clamp(P95×3, 0.5s, EM_REQUEST_TIMEOUT_SEC)。好窗口收紧到 ~1s 快速判死边缘慢 IP，
# 差窗口自动放宽到静态上限不误杀；失败尝试不入窗。0=始终用静态值
EM_REQUEST_DYNAMIC_TIMEOUT=1

# 最大重试次数：换 IP 重试上限（0=不重试，首次失败即抛出）。
# 全量翻页有补漏轮兜底，重试预算不宜过大：整批 IP 都坏时 10 次重试=单页最坏烧 30s，
# 降到 4 快速失败交由补漏轮换新一批 IP，总预算不变但失败成本摊薄
EM_MAX_RETRIES=4

# 退避：换 IP 重试每次都是全新出口 IP，不该被指数退避越罚越重；
# backoff_cap_sec 给退避封顶，避免代理 IP（TTL 仅数十秒）在长退避里过期。
# 退避基数（秒）：第 n 次重试等待 backoff_sec * 2^n，封顶 backoff_cap_sec
EM_BACKOFF_SEC=0.2

# 退避封顶（秒）：退避序列 0.2→0.4→0.8→1.6→2.0→2.0…（设为空则不封顶）
EM_BACKOFF_CAP_SEC=2.0

# 退避随机抖动（秒）：错开多 worker 同刻失败→同刻重试的惊群
EM_BACKOFF_JITTER_SEC=0.1
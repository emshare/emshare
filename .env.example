# 动态代理配置示例：复制为 .env 后按需修改（.env 已在 .gitignore，不入库）。
# 短效 IP：TTL 与 provider 的 time 参数同口径（默认 30 秒），过期前留安全余量自动换 IP。

# 代理总开关：1=开启，0=关闭（关闭后全程直连，等价 EM_PROXY_MODE=never）
EM_PROXY_ENABLED=1

# 代理 API 地址（携趣动态 IP）：返回 ip:port 文本，按行解析。替换 YOUR_UID/YOUR_VKEY。
# 多源冗余：EM_PROXY_API 为主源（如免费源），EM_PROXY_API_BACKUP 等后缀 KEY 为备用源（如收费源），
# 按名排序拼接；主源空返回/异常/回源超慢（>3s 疑似限流）时自动降级备用源 60s，窗口后自动恢复。
# 每个源独立一行，注释掉某行即可停用该源。
# 注意：URL 含 & 时不要用 source .env 加载（bash 会截断），本项目用 em.core.env.load_dotenv 安全加载。
EM_PROXY_API=http://api.xiequ.cn/VAD/GetIp.aspx?act=get&uid=YOUR_UID&vkey=YOUR_VKEY&num=5&time=30&plat=1&re=1&type=0&so=1&ow=1&spl=1&addr=&db=1
# EM_PROXY_API_BACKUP=http://api.xiequ.cn/VAD/GetIp.aspx?act=get&uid=YOUR_UID&vkey=YOUR_VKEY&num=5&time=30&plat=1&re=1&type=2&so=1&ow=1&spl=1&addr=&db=1

# 每次回源拉取的代理 IP 数量（备用池大小，1=只取当前用，>1 可减少回源频率）
# 必须与上面 URL 里的 num 参数一致：厂商按 URL 的 num 计费，池子只取前 N 个；
# 写小了就是"付 5 个的钱只用 2 个"（账本里表现为 采购 明显大于 进池+预筛淘汰）
EM_PROXY_NUM=5

# 代理 IP 有效期（秒）：与 API 的 time 参数同口径；池内在硬到期前 3s 起后台续期
EM_PROXY_TTL_SEC=30

# 安全余量（秒）：TTL 到期前提前这么多秒视为过期，避免用到临过期 IP。
# 池内会在"硬到期（TTL-余量）前 3s"起后台线程续期，成功则旧 IP 用满余量、
# 失败则继续用旧 IP 到硬到期——不会因为回源失败把还在工作的出口丢掉
EM_PROXY_SAFETY_MARGIN_SEC=3

# 拉取代理 API 的超时（秒）：超时则返回空列表，退化直连
EM_PROXY_TIMEOUT_SEC=8

# 代理路由模式：auto=默认直连，某 host 被封后自动切代理，代理稳定后周期探测回退直连；
# always=全程代理；never=全程直连。auto 下各 host(push2/push2his/pushguest)独立决策。
EM_PROXY_MODE=auto

# auto 模式：直连连续失败达此阈值后切代理（403/429 立即切，不等待累计）
EM_PROXY_DIRECT_FAILS=3

# auto 模式：代理下连续成功达此阈值后，尝试探测直连是否恢复
EM_PROXY_PROXY_SUCCESSES=5

# auto 模式：切代理后的冷却期（秒）：期间不做探测，避免刚切代理就频繁试探直连
EM_PROXY_COOLDOWN_SEC=300

# 回源预筛：1=开启。进池前对回源 IP 并发发一个与业务同口径的探测请求（同 host/fs/页大小），
# 读预算取 EM_REQUEST_TIMEOUT_SEC（上限 3s，保证探测不会比业务更宽松），
# 判死的直接记黑名单不进池——实测死 IP 率时段性 0%~82%；代价是好 IP 时段每轮回源多约 1s
EM_PROXY_PREFILTER=1

# 预筛范围：前 N 个源参与探测（按上面 EM_PROXY_API* 的书写顺序，主源在前）。
# 收费备用源建议不预筛（N=1）：淘汰等于把买来的 IP 直接扔掉；N=0 表示全部不预筛
EM_PROXY_PREFILTER_SOURCES=1

# 整批探测全死后的处置：lenient=改用 1.5s 读预算的快筛继续过滤（5s 窗口，默认）；
# adopt=暂停预筛 10s、期间批次直接进池（旧行为，回退用）。实测放行未验证 IP 的代价是
# 每个 hang 撞 2 次业务超时（≈3.5s），远高于一次快筛（≈1.5s）；
# 同窗口对照下 lenient 的失败数 4→1 / 11→5 / 10→0，采购从未更高
EM_PROXY_DEGRADED_MODE=lenient

# 单次 HTTP 请求超时（秒）：(连接, 读取) 分别计时，超时归类为 NetworkError 触发换 IP 重试。
# 坏代理多卡在连接阶段，connect 取小值可快速判死（requests 元组超时，二者不叠加）。
# 读取超时同时是动态超时的上限，也是预筛探测的读取预算（探测不能比业务宽松，
# 否则会放行"探测能过、业务必超时"的出口）。实测经代理整页 0.79~1.25s，3 给 2~4 倍余量。
# 大响应接口（K 线全量，实测 8502 行）在渠道内声明自己的读预算并可超过此值——
# 它是单请求无分页，放宽不会放大失败成本
EM_REQUEST_CONNECT_TIMEOUT_SEC=3
EM_REQUEST_TIMEOUT_SEC=3

# 动态读超时（P95 滑动窗口）：1=开启。按直连/代理分桶统计最近 20 次成功请求耗时，
# 读超时 = clamp(P95×3, 1.5s, EM_REQUEST_TIMEOUT_SEC)。下限 1.5s 覆盖整页均值，
# 避免快窗口把正常页判成超时；差窗口自动放宽到静态上限不误杀；失败尝试不入窗。0=始终用静态值
EM_REQUEST_DYNAMIC_TIMEOUT=1

# 最大重试次数：换 IP 重试上限（0=不重试，首次失败即抛出）。
# 全量翻页有补漏轮兜底，重试预算不宜过大：整批 IP 都坏时 10 次重试=单页最坏烧 30s，
# 降到 4 快速失败交由补漏轮换新一批 IP，总预算不变但失败成本摊薄
EM_MAX_RETRIES=4

# 退避：换 IP 重试每次都是全新出口 IP，不该被指数退避越罚越重；
# backoff_cap_sec 给退避封顶，避免代理 IP（TTL 仅数十秒）在长退避里过期。
# 退避基数（秒）：第 n 次重试等待 backoff_sec * 2^n，封顶 backoff_cap_sec
EM_BACKOFF_SEC=0.2

# 退避封顶（秒）：退避序列 0.2→0.4→0.8→1.6→2.0→2.0…（设为空则不封顶）
EM_BACKOFF_CAP_SEC=2.0

# 退避随机抖动（秒）：错开多 worker 同刻失败→同刻重试的惊群
EM_BACKOFF_JITTER_SEC=0.1